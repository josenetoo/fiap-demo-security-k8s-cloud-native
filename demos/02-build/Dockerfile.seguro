# Exemplo de imagem endurecida: multi-stage, distroless e nonroot.

# Estagio de build. A tag flutuante 1.23 traz o ultimo patch do Go 1.23,
# com as correcoes mais recentes da biblioteca padrao (origem das
# vulnerabilidades "gobinary"). Recompilar com um Go recente as reduz.
FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY app/go.mod .
COPY app/main.go .
# Binario estatico: nao depende de libc e executa em imagem sem sistema.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /server .

# Estagio final: apenas o binario, sem shell e sem gerenciador de pacotes.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /server /server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/server"]
