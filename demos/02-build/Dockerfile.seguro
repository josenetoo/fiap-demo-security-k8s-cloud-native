# Build multi-stage com imagem final distroless e nonroot.

# A tag seleciona a linha Go 1.25; rebuilds com toolchain corrigida podem reduzir achados gobinary.
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY app/go.mod .
COPY app/main.go .
# Binario estatico para execucao sem libc.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /server .

# Imagem final sem shell nem gerenciador de pacotes.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /server /server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/server"]
