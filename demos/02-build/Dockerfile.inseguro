# Base completa com tag mutavel amplia a superficie de ataque.
FROM golang:1.22

WORKDIR /app
COPY app/ .
RUN go build -o /server .

# Credenciais AWS ficticias em formato detectavel por Trivy/gitleaks; permanecem na camada e no historico da imagem.
ENV AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
ENV AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

EXPOSE 8080
# USER omitido intencionalmente: o processo executa como root.
CMD ["/server"]
